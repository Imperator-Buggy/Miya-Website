# Copy to .env and fill in. Never commit .env.

# Public URL of the site, no trailing slash (used for payment redirects).
APP_URL=http://localhost:8000

# Database. Leave DB_* unset for local SQLite (data/miya.sqlite).
# Production: Supabase project nqnomapkknhcsgginruq, Session pooler (Seoul, IPv4-friendly).
# Easiest: Supabase → Connect → Session pooler → URI, with your password filled in. Never commit it.
DATABASE_URL=postgresql://postgres.nqnomapkknhcsgginruq:YOUR-PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# (Or split it: DB_DSN=pgsql:host=...;port=5432;dbname=postgres;sslmode=require plus DB_USER / DB_PASS.)

# Payments — leave a provider's key empty to hide that option at checkout.
# Ziina (UAE): Ziina Business app → Developers → API key. ZIINA_TEST=true uses the sandbox.
ZIINA_API_KEY=
ZIINA_TEST=true
# Stripe: Dashboard → Developers → API keys. Test keys start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard at /admin (user: miya).
ADMIN_PASSWORD=change-me
