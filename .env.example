# Copy to .env and fill in. Never commit .env.

# Public URL of the site, no trailing slash (used for Stripe redirects).
APP_URL=http://localhost:8000

# Database. Leave everything unset for local SQLite (data/miya.sqlite).
# Supabase: Connect → Session pooler → URI. Paste the whole thing with your password filled in:
# DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# (Alternatively DB_DSN=pgsql:host=...;port=5432;dbname=postgres;sslmode=require with DB_USER / DB_PASS.)

# Payments — leave a provider's key empty to hide that option at checkout.
# Ziina (UAE): Ziina Business app → Developers → API key. ZIINA_TEST=true uses the sandbox.
ZIINA_API_KEY=
ZIINA_TEST=true
# Stripe: Dashboard → Developers → API keys. Test keys start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard at /admin (user: miya).
ADMIN_PASSWORD=change-me
