# Copy to .env and fill in. Never commit .env.

# Public URL of the site, no trailing slash (used for payment redirects).
APP_URL=http://localhost:8000

# Database. Leave DB_* unset for local SQLite (data/miya.sqlite).
# Production: Supabase project nqnomapkknhcsgginruq, Session pooler (Seoul, IPv4-friendly).
# Only the password is secret — set it here locally and in Render's dashboard, never in git.
DB_DSN=pgsql:host=aws-0-ap-northeast-2.pooler.supabase.com;port=5432;dbname=postgres;sslmode=require
DB_USER=postgres.nqnomapkknhcsgginruq
DB_PASS=
# (Or one line instead of the three above: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres)

# Payments — leave a provider's key empty to hide that option at checkout.
# Ziina (UAE): Ziina Business app → Developers → API key. ZIINA_TEST=true uses the sandbox.
ZIINA_API_KEY=
ZIINA_TEST=true
# Stripe: Dashboard → Developers → API keys. Test keys start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard at /admin (user: miya).
ADMIN_PASSWORD=change-me
