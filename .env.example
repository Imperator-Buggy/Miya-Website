# Copy to .env and fill in. Never commit .env.

# Public URL of the site, no trailing slash (used for Stripe redirects).
APP_URL=http://localhost:8000

# Database. Leave DB_DSN unset for local SQLite (data/miya.sqlite).
# Supabase (Postgres) — from Project Settings → Database → Connection string (URI, session mode):
# DB_DSN=pgsql:host=aws-0-ap-south-1.pooler.supabase.com;port=5432;dbname=postgres;sslmode=require
# DB_USER=postgres.xxxxxxxxxxxx
# DB_PASS=your-database-password

# Payments — leave a provider's key empty to hide that option at checkout.
# Ziina (UAE): Ziina Business app → Developers → API key. ZIINA_TEST=true uses the sandbox.
ZIINA_API_KEY=
ZIINA_TEST=true
# Stripe: Dashboard → Developers → API keys. Test keys start with sk_test_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin dashboard at /admin (user: miya).
ADMIN_PASSWORD=change-me
